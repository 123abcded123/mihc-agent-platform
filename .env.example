# ============================================================
# MIHC 医疗科研智能 Agent 平台 配置示例
# 复制为 .env 后按实际环境修改（.env 不入库）
# ============================================================

# ===== LLM（模型网关：vLLM Qwen3-32B 优先，OpenAI 兼容端点）=====
LLM_BASE_URL=
LLM_MODEL=gpt-4o
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=
OPENAI_API_KEY=

# ===== 嵌入模型（BGE-M3）=====
# local_bge_m3：本地 sentence-transformers；openai_compatible：远程嵌入端点
EMBEDDING_PROVIDER=local_bge_m3
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_DEVICE=cpu
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=

# ===== BGE-Reranker（云端无模型文件时设 0 降级为 RRF 得分排序）=====
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_TOP_K=5
RERANKER_DEVICE=cpu
RERANKER_ENABLED=1

# ===== Milvus（留空 → milvus-lite 本地文件模式）=====
MILVUS_URI=
MILVUS_TOKEN=
MILVUS_LOCAL_PATH=./data/milvus_lite.db
MILVUS_COLLECTION=mihc_knowledge
MILVUS_DIM=1024

# ===== Elasticsearch（留空 → 本地 BM25 回退）=====
ES_URL=
ES_INDEX=mihc_keywords
ES_LOCAL_INDEX_PATH=./data/bm25_index.json

# ===== PostgreSQL（默认 SQLite 回退）=====
DATABASE_URL=sqlite:///./data/mihc.db

# ===== Redis（留空 → fakeredis 回退）=====
REDIS_URL=
USE_FAKE_REDIS=1
SESSION_TTL_SEC=3600

# ===== MongoDB（留空 → JSON 文件回退）=====
MONGO_URL=
MONGO_DB=mihc_platform
MONGO_LOCAL_DIR=./data/mongo_json

# ===== 登录鉴权 =====
MIHC_AUTH_SECRET=dev-only-secret-change-me
MIHC_AUTH_TOKEN_TTL=86400
MIHC_ALLOW_REGISTER=1
# 可选：首次启动自动创建管理员
MIHC_ADMIN_USER=
MIHC_ADMIN_PASSWORD=

# ===== 跨域（前端独立域名部署时填写）=====
MIHC_CORS_ORIGINS=*

# ===== 客户 mIHC 服务 =====
MIHC_INTENT_MIN_CONFIDENCE=0.75
MIHC_OBJECT_STORAGE_DIR=./data/objects
MIHC_MAX_TABLE_ROWS=500000
MIHC_MAX_PROJECT_FILES=100

# ===== BERT 意图识别（可选微调模型路径）=====
INTENT_MODEL_PATH=
INTENT_BASE_MODEL=bert-base-chinese
INTENT_DEVICE=cpu
INTENT_MIN_CONFIDENCE=0.6

# ===== 检索链参数 =====
RETRIEVAL_TOP_K=5
KEYWORD_TOP_K=5
RRF_K=60
ENABLE_QUERY_REWRITE=1
ENABLE_HYDE=1
MIN_RETRIEVAL_CONFIDENCE=0.40
MAX_CONTEXT_CHARS=8192

# ===== 安全 =====
DFA_WORDS_FILE=./security/sensitive_words.txt
ENABLE_INPUT_SCAN=1
ENABLE_PROMPT_GUARD=1
ENABLE_OUTPUT_SCAN=1

# ===== 观测 =====
OTEL_ENABLED=1
OTEL_EXPORTER=console
OTEL_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=mihc-agent-platform
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
PROMETHEUS_ENABLED=1

# ===== 平台 =====
TENANT_ID=mihc
MAX_CONVERSATION_HISTORY=20
MAX_AGENT_STEPS=8
TOOL_TIMEOUT_SEC=30
FAST_MODE=0

# ===== API =====
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=1
MAX_UPLOAD_SIZE_MB=20
