# ---- MIHC 后端镜像（FastAPI，Sealos 上监听 8080）----
FROM python:3.11-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# 先装依赖，利用镜像层缓存
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 拷贝应用代码（.dockerignore 排除模型/数据/前端 node_modules 等）
COPY . .

RUN mkdir -p data

EXPOSE 8080

# 端口由 API_PORT 环境变量控制（Sealos 设置 API_PORT=8080）
CMD ["sh", "-c", "uvicorn app:app --host 0.0.0.0 --port ${API_PORT:-8080}"]
