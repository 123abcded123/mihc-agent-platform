{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "请求量（按意图）",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (intent) (rate(mihc_request_total[5m]))",
          "legendFormat": "{{intent}}"
        }
      ]
    },
    {
      "title": "P50/P95 请求延迟",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(mihc_request_latency_seconds_bucket[5m])) by (le))", "legendFormat": "P50" },
        { "expr": "histogram_quantile(0.95, sum(rate(mihc_request_latency_seconds_bucket[5m])) by (le))", "legendFormat": "P95" }
      ]
    },
    {
      "title": "Agent 耗时",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(mihc_agent_duration_seconds_bucket[5m])) by (le, agent))",
          "legendFormat": "{{agent}}"
        }
      ]
    },
    {
      "title": "护栏拦截次数",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "sum by (side) (rate(mihc_guard_blocks_total[5m]))", "legendFormat": "{{side}}" }
      ]
    },
    {
      "title": "检索候选分布",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(mihc_retrieval_candidates_bucket[5m])) by (le))",
          "legendFormat": "candidates P50"
        }
      ]
    },
    {
      "title": "LLM Token 消耗",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "expr": "sum(increase(mihc_llm_tokens_total[24h]))", "legendFormat": "24h tokens" }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["mihc"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "title": "MIHC Agent Platform",
  "uid": "mihc-agent-platform",
  "version": 1
}
